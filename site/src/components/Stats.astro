---
// A fought record's stat inputs: health/magicka/stamina from race, class and offsets, its skills,
// and how it fights. Every number is read from the records; see FamilyData['stats'].
import type { FamilyData } from '../schema.ts';
import { md, ref } from '../lib/format.ts';

interface Props { stats: NonNullable<FamilyData['stats']> }
const { stats: s } = Astro.props;

const attrs = [
  { key: 'health', label: 'Health', colour: '#c9412e' },
  { key: 'magicka', label: 'Magicka', colour: '#4f7fd0' },
  { key: 'stamina', label: 'Stamina', colour: '#5f9a4a' },
] as const;
const skills = [...s.skills].sort((a, b) => b.stored - a.stored || b.weight - a.weight);
const aiText = s.ai ? Object.entries(s.ai).map(([k, v]) => `${k.replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase()} ${v}`).join(' · ') : '';
---

<h2>Stats <span class:list={['conf', s.confidence]}>{s.confidence}</span></h2>
<p class="stats-meta">
  <span set:html={ref(s.record)} />
  {s.flags.map((f) => <span class="flag">{f}</span>)}
</p>

<div class="attrs">
  {attrs.map((a) => (
    <div class="attr panel" style={`--c:${a.colour}`}>
      <div class="attr-head">
        <span class="attr-name">{a.label}</span>
        <span class="attr-val" title="stored in the record">{s.stored[a.key]}</span>
      </div>
      <dl>
        <dt>race start</dt><dd>{s.race.start[a.key]}</dd>
        <dt>offset</dt><dd>+{s.offsets[a.key]}</dd>
        <dt>class weight</dt><dd>{s.class.statWeights[a.key]}</dd>
        <dt>regen</dt><dd>{s.race.regen[a.key]}</dd>
      </dl>
    </div>
  ))}
</div>

<div class="panel skills">
  <div class="skills-head">
    <h3>Skills</h3>
    <span class="sub">stored value · class weight (how fast it grows with level)</span>
  </div>
  <ul>
    {skills.map((k) => (
      <li class:list={{ trained: k.weight > 0 }}>
        <span class="sk-name">{k.skill}</span>
        <span class="sk-bar" aria-hidden="true"><span style={`width:${Math.min(k.stored, 100)}%`}></span></span>
        <span class="sk-val">{k.stored}</span>
        <span class="sk-w" title="class skill weight">{k.weight > 0 ? `×${k.weight}` : ''}</span>
      </li>
    ))}
  </ul>
</div>

<p class="stats-foot">
  Race <span set:html={ref(s.race.ref)} /> · class <span set:html={ref(s.class.ref)} />
  {s.combatStyle && <> · combat style <span set:html={ref(s.combatStyle)} /></>}
  · speed {s.speed}%{aiText && <> · {aiText}</>}
</p>
{s.note && <p class="sub stats-note" set:html={md(s.note)} />}

<style>
  .stats-meta { display: flex; flex-wrap: wrap; gap: 0.4rem 0.6rem; align-items: center; margin: -0.3rem 0 0.9rem; }
  .flag { font-size: 0.72rem; padding: 0.05rem 0.45rem; border: 1px solid var(--line-strong); border-radius: 4px; color: var(--muted); }
  .attrs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .attr { border-top: 3px solid var(--c); padding: 1rem 1.2rem; }
  .attr-head { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.6rem; }
  .attr-name { font: 600 0.95rem var(--serif); letter-spacing: 0.08em; text-transform: uppercase; color: var(--c); }
  .attr-val { font: 700 1.9rem var(--serif); color: var(--text); font-variant-numeric: tabular-nums; }
  .attr dl { display: grid; grid-template-columns: 1fr auto; gap: 0.15rem 1rem; margin: 0; font-size: 0.9rem; }
  .attr dt { color: var(--muted); }
  .attr dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }

  .skills { margin-top: 1rem; }
  .skills-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 1rem; margin-bottom: 0.6rem; }
  .skills-head h3 { margin: 0; }
  .skills ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.3rem 2rem; }
  .skills li { display: grid; grid-template-columns: 7.5rem 1fr 2.2rem 2rem; align-items: center; gap: 0.6rem; font-size: 0.9rem; color: var(--muted); }
  .skills li.trained { color: var(--text); }
  .sk-bar { height: 6px; border-radius: 3px; background: rgba(255,255,255,.06); overflow: hidden; }
  .sk-bar span { display: block; height: 100%; background: rgba(255,255,255,.28); }
  .trained .sk-bar span { background: var(--gold-deep); }
  .sk-val { text-align: right; font-variant-numeric: tabular-nums; }
  .sk-w { font-family: var(--mono); font-size: 0.75rem; color: var(--gold); }
  .stats-foot { margin-top: 0.9rem; font-size: 0.92rem; color: var(--muted); }
  .stats-note { max-width: 80ch; font-size: 0.85rem; color: var(--muted); }

  @media (max-width: 720px) {
    .attrs { grid-template-columns: 1fr; }
    .skills ul { grid-template-columns: 1fr; }
  }
</style>

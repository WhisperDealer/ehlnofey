---
// The colour bar from the Bands of Power poster: one segment per band, as wide as its range.
import { bands, segment, bandRange } from '../lib/census.ts';
---
<div class="bandbar" role="img" aria-label="The ten bands of power on one scale, levels 1 to 82 and above">
  <div class="bar">
    {bands.bands.map((b) => {
      const s = segment(b);
      return <a class:list={['seg', { cap: b.max === null }]} href={`#band-${b.id}`} style={`left:${s.left}%;width:${s.width}%;--c:${b.colour}`} title={`${b.id} ${b.name}: ${bandRange(b)}`}><span>{b.id}</span></a>;
    })}
  </div>
  <div class="ticks" aria-hidden="true">
    {bands.bands.map((b) => <span style={`left:${segment(b).left}%`}>{b.max === null ? `${b.min}+` : b.min}</span>)}
  </div>
</div>

<style>
  .bandbar { padding: 1.1rem 1.25rem 0.6rem; background: rgba(8, 11, 19, 0.75); border: 1px solid var(--line); border-radius: var(--radius); }
  .bar { position: relative; height: 38px; border-radius: 6px; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,.4); }
  .seg { position: absolute; top: 0; bottom: 0; background: var(--c); display: grid; place-items: center; text-decoration: none;
    font: 700 0.72rem var(--serif); color: rgba(255,255,255,.85); border-right: 1px solid rgba(0,0,0,.18); transition: filter .15s; }
  .seg:hover { filter: brightness(1.18); }
  .seg.cap { color: #1b160b; background: linear-gradient(90deg, var(--c), #fff3c9); }
  .ticks { position: relative; height: 1.6rem; font: 500 0.72rem var(--sans); color: var(--muted); }
  .ticks span { position: absolute; top: 0.35rem; transform: translateX(-2px); }
  @media (max-width: 640px) { .seg span { display: none; } .ticks span:nth-child(even) { display: none; } .bandbar { padding: 0.8rem 0.8rem 0.4rem; } }
</style>

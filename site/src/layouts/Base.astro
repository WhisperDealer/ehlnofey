---
import { href, loadCensus } from '../lib/census.ts';

interface Props {
  title: string;
  description?: string;
  crumbs?: { label: string; path: string }[];
}
const { title, description = 'Ehlnofey, a Skyrim deleveling mod: the enemy census.', crumbs = [] } = Astro.props;
const groups = await loadCensus();
const fullTitle = title === 'Ehlnofey' ? 'Ehlnofey — The Ten Bands of Power' : `${title} · Ehlnofey`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={href('favicon.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alegreya+Sans:ital,wght@0,400;0,500;0,700;1,400&family=Cinzel:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <div class="sky" aria-hidden="true"></div>
    <header class="topbar">
      <nav class="wrap topnav" aria-label="Site">
        <a class="brand" href={href()}>Ehlnofey</a>
        <ul>
          <li><a href={href('#bands')}>Bands</a></li>
          {groups.map((g) => <li><a href={href(`${g.id}/`)}>{g.title}</a></li>)}
        </ul>
      </nav>
    </header>

    {
      crumbs.length > 0 && (
        <nav class="wrap crumbs" aria-label="Breadcrumb">
          <a href={href()}>Home</a>
          {crumbs.map((c) => (
            <>
              <span aria-hidden="true">›</span>
              <a href={href(c.path)}>{c.label}</a>
            </>
          ))}
        </nav>
      )
    }

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap footer">
      <span class="tracked">Fixed levels · No scaling</span>
      <span>
        Built from <a href="https://github.com/WhisperDealer/ehlnofey/tree/main/census"><code>census/*.json</code></a>
        · raw data at <a href={href('data/index.json')}><code>/data</code></a>
      </span>
      <span class="credit">Mod by <strong>WhisperDealer</strong></span>
    </footer>

    <script>
      // Click a FormKey to copy it.
      document.addEventListener('click', async (e) => {
        const el = (e.target as HTMLElement).closest<HTMLElement>('[data-copy]');
        if (!el) return;
        try {
          await navigator.clipboard.writeText(el.dataset.copy!);
          el.classList.add('copied');
          setTimeout(() => el.classList.remove('copied'), 900);
        } catch {
          /* clipboard blocked: the title attribute still shows the FormKey */
        }
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    --bg: #070a12;
    --panel: rgba(12, 16, 26, 0.82);
    --panel-solid: #0d111c;
    --line: rgba(214, 196, 150, 0.14);
    --line-strong: rgba(214, 196, 150, 0.28);
    --text: #e7e2d6;
    --muted: #a49d8c;
    --gold: #f1d68b;
    --gold-deep: #c9a54e;
    --code: #cfe3d4;
    --radius: 12px;
    --serif: 'Cinzel', 'Trajan Pro', Georgia, serif;
    --sans: 'Alegreya Sans', 'Segoe UI', system-ui, sans-serif;
    --mono: 'JetBrains Mono', ui-monospace, Consolas, monospace;
    color-scheme: dark;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 400 1.0625rem/1.55 var(--sans);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
  }
  main { flex: 1; }

  /* The night sky behind every page: two nebulae and a scatter of stars. */
  .sky {
    position: fixed;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(1.5px 1.5px at 12% 18%, #fff8 50%, transparent 51%),
      radial-gradient(1px 1px at 27% 64%, #fff6 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 44% 32%, #fff7 50%, transparent 51%),
      radial-gradient(1px 1px at 63% 12%, #fff5 50%, transparent 51%),
      radial-gradient(2px 2px at 78% 44%, #fff9 50%, transparent 51%),
      radial-gradient(1px 1px at 88% 78%, #fff5 50%, transparent 51%),
      radial-gradient(1px 1px at 8% 86%, #fff6 50%, transparent 51%),
      radial-gradient(1.5px 1.5px at 52% 90%, #fff5 50%, transparent 51%),
      radial-gradient(ellipse 60% 45% at 6% 8%, rgba(166, 58, 40, 0.32), transparent 70%),
      radial-gradient(ellipse 55% 50% at 78% 6%, rgba(54, 120, 84, 0.28), transparent 70%),
      radial-gradient(ellipse 70% 40% at 50% 100%, rgba(52, 70, 110, 0.35), transparent 70%),
      linear-gradient(180deg, #0a0e1a 0%, #070a12 60%, #0b1020 100%);
  }
  .sky::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(1px 1px at 50% 50%, rgba(255, 255, 255, 0.35) 50%, transparent 51%);
    background-size: 97px 89px;
    opacity: 0.35;
  }

  .wrap { width: min(1120px, 100% - 32px); margin-inline: auto; }

  a { color: var(--gold); text-decoration-color: rgba(241, 214, 139, 0.35); text-underline-offset: 3px; }
  a:hover { text-decoration-color: var(--gold); }
  :focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; border-radius: 4px; }

  h1, h2, h3 { font-family: var(--serif); font-weight: 600; color: var(--gold); line-height: 1.2; letter-spacing: 0.02em; }
  h1 { font-size: clamp(2rem, 5vw, 3rem); margin: 0.4em 0 0.2em; }
  h2 { font-size: 1.45rem; margin: 2.2rem 0 0.8rem; font-variant: small-caps; letter-spacing: 0.06em; }
  h3 { font-size: 1.1rem; margin: 1.4rem 0 0.6rem; }
  p { margin: 0.5em 0; }

  code { font-family: var(--mono); font-size: 0.82em; color: var(--code); overflow-wrap: anywhere; }
  .fk { font-family: var(--mono); font-size: 0.78em; color: var(--muted); cursor: copy; border-bottom: 1px dotted transparent; }
  .fk:hover { color: var(--text); border-bottom-color: var(--muted); }
  .fk.copied { color: var(--gold); }
  .fk .master { opacity: 0.75; }

  .tracked { font-family: var(--serif); letter-spacing: 0.28em; text-transform: uppercase; font-size: 0.75rem; color: var(--muted); }

  /* Top bar */
  .topbar { border-bottom: 1px solid var(--line); background: rgba(7, 10, 18, 0.7); backdrop-filter: blur(8px); position: sticky; top: 0; z-index: 10; }
  .topnav { display: flex; align-items: center; gap: 1.5rem; min-height: 56px; flex-wrap: wrap; }
  .brand { font-family: var(--serif); font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; text-decoration: none; font-size: 1.05rem; }
  .topnav ul { display: flex; gap: 1.1rem; list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  .topnav ul a { color: var(--text); text-decoration: none; font-size: 0.95rem; }
  .topnav ul a:hover { color: var(--gold); }

  .crumbs { display: flex; gap: 0.5rem; align-items: center; margin-top: 1.2rem; font-size: 0.9rem; color: var(--muted); flex-wrap: wrap; }
  .crumbs a { color: var(--muted); }

  .footer { display: flex; flex-wrap: wrap; gap: 0.8rem 2rem; justify-content: space-between; align-items: center; padding: 2.5rem 0 2rem; margin-top: 3rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.9rem; }
  .footer .credit strong { font-family: var(--serif); color: var(--gold); letter-spacing: 0.05em; }

  /* Panels and tables */
  .panel { background: var(--panel); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem 1.4rem; }
  .table-scroll { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius); background: var(--panel); }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  th, td { text-align: left; vertical-align: top; padding: 0.6rem 0.85rem; border-bottom: 1px solid var(--line); }
  th { font-family: var(--serif); font-weight: 600; font-size: 0.78rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); background: rgba(255, 255, 255, 0.02); white-space: nowrap; }
  tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: rgba(241, 214, 139, 0.03); }
  td code { overflow-wrap: normal; white-space: nowrap; }
  td.num { white-space: nowrap; font-variant-numeric: tabular-nums; }

  .conf { font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; padding: 0.1rem 0.45rem; border-radius: 999px; border: 1px solid var(--line-strong); color: var(--muted); vertical-align: middle; margin-left: 0.6rem; font-variant: normal; text-transform: none; }
  .conf.verified { color: #9fd3a8; border-color: rgba(159, 211, 168, 0.4); }

  .lede { color: var(--muted); max-width: 70ch; }
  ul.bullets { padding-left: 1.2rem; margin: 0; }
  ul.bullets li { margin: 0.35rem 0; }

  @media (max-width: 640px) {
    body { font-size: 1rem; }
    th, td { padding: 0.5rem 0.6rem; }
    .panel { padding: 1rem; }
  }
</style>

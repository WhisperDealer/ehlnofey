{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "meta": {
      "type": "object",
      "properties": {
        "spec": {
          "type": "string"
        },
        "updated": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "required": [
        "updated"
      ],
      "additionalProperties": false
    },
    "intro": {
      "type": "string"
    },
    "families": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "holds": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "holds"
        ],
        "additionalProperties": false
      }
    },
    "sweep": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "community",
            "unverified"
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "confidence",
        "text"
      ],
      "additionalProperties": false
    },
    "filedElsewhere": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "where": {
            "type": "string"
          }
        },
        "required": [
          "record",
          "what",
          "where"
        ],
        "additionalProperties": false
      }
    },
    "neverMet": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "record": {
            "type": "string"
          },
          "what": {
            "type": "string"
          },
          "why": {
            "type": "string"
          }
        },
        "required": [
          "record",
          "what",
          "why"
        ],
        "additionalProperties": false
      }
    },
    "neverInGame": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "verified",
            "community",
            "unverified"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "record": {
                "type": "string"
              },
              "why": {
                "type": "string"
              }
            },
            "required": [
              "record",
              "why"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "confidence",
        "rows"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "title",
    "order",
    "meta",
    "families"
  ],
  "additionalProperties": false
}
